# ── Database ─────────────────────────────────────────────────────────────────
# MySQL connection string for blog posts and training enquiries
DATABASE_URL=mysql://user:password@host:3306/advanseit

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Used for contact form and training enquiry emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@advanseit.com.au
SMTP_PASS=your-app-password

# Optional: override the "To" address for owner notifications (defaults to SMTP_USER)
NOTIFY_TO=admin@advanseit.com.au

# ── Analytics (optional) ──────────────────────────────────────────────────────
# Self-hosted Umami analytics — leave blank to disable the script
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ── Blog AI Generation (optional) ────────────────────────────────────────────
# Only needed if you use the auto blog scheduler
# Uses OpenAI-compatible endpoint
OPENAI_API_KEY=

# ── S3 / Cloudflare R2 (optional — for blog cover image storage) ──────────────
# Leave blank to disable blog image uploads (images will still be AI-generated
# but won't be stored; blog posts will use the placeholder image instead)
S3_BUCKET=
S3_REGION=ap-southeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
# For Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Public CDN base URL for stored images
S3_PUBLIC_URL=

# ── JWT / Session ─────────────────────────────────────────────────────────────
# Required if using blog admin dashboard
JWT_SECRET=change-me-to-a-long-random-string
